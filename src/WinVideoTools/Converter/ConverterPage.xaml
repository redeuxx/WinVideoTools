<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinVideoTools.Converter.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinVideoTools.Converter"
    xmlns:app="using:WinVideoTools"
    NavigationCacheMode="Required">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Convert" Style="{StaticResource TitleTextBlockStyle}" />

        <app:WrapPanel Grid.Row="1">
            <ComboBox x:Name="PresetBox" Header="HandBrake preset" PlaceholderText="Import a preset to start" Width="360"
                      SelectionChanged="PresetBox_SelectionChanged" />
            <Button x:Name="ImportButton" Content="Import..." Click="Import_Click" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Import presets from a HandBrake preset file and save them for later" />
            <Button x:Name="ExportButton" Content="Export..." Click="Export_Click" IsEnabled="False" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Save the selected preset as a file HandBrake can import" />
            <Button x:Name="DeletePresetButton" Content="Delete" Click="DeletePreset_Click" IsEnabled="False" VerticalAlignment="Bottom" />
        </app:WrapPanel>

        <TextBlock x:Name="PresetNotes" Grid.Row="2" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SameFolderBox" Content="Save next to the source file" VerticalAlignment="Center"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <TextBox x:Name="OutputBox" Grid.Column="1" PlaceholderText="Output folder" AutomationProperties.Name="Output folder"
                     TextChanged="OutputBox_TextChanged" />
            <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" />
        </Grid>

        <!-- Takes no space until shown. The checkboxes keep their names, so code reads them as before. -->
        <ContentDialog x:Name="OptionsDialog" Title="Convert options" CloseButtonText="Close" DefaultButton="Close">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <CheckBox x:Name="SkipHevcBox" Content="Skip files already in HEVC (H.265)"
                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    <CheckBox x:Name="SkipHevc1080Box" Content="Only if 1080p or smaller" Margin="28,0,0,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"
                              ToolTipService.ToolTip="Skips HEVC files whose shorter side is 1080 pixels or less; larger HEVC files are still converted" />
                </StackPanel>
                <CheckBox x:Name="DeleteLargerBox" Content="Delete output if larger than original"
                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                <StackPanel Spacing="4">
                    <CheckBox x:Name="DeleteOriginalBox" Content="Delete original if output is smaller"
                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    <TextBlock Margin="28,0,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Permanently deletes the source after a full-length conversion that saved space. You confirm it each time you convert." />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Groups wrap as units so related controls stay together when the window is narrow.
             Convert and the run button share a MinWidth, and Remove selected keeps its place while hidden,
             so swapping or showing them never moves controls to another line or shifts the list under the pointer. -->
        <app:WrapPanel Grid.Row="4" HorizontalSpacing="16">
            <app:WrapPanel>
                <DropDownButton x:Name="ListButton" Content="List"
                                ToolTipService.ToolTip="Add files or folders, look for new videos in folders added before, or clear the list">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Add files..." Click="AddFiles_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add folder..." Click="AddFolder_Click"
                                            ToolTipService.ToolTip="Adds every video in the folder and its subfolders, except ones the history says are already processed and unchanged">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="RescanItem" Text="Rescan folders" Click="Rescan_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Look in every folder added before, in this list or the history, for videos that are new or changed since they were processed, and queue them">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ClearItem" Text="Clear list" Click="Clear_Click" IsEnabled="False">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" IsEnabled="False" Opacity="0" />
            </app:WrapPanel>
            <app:WrapPanel>
                <DropDownButton x:Name="SessionButton" Content="Session"
                                ToolTipService.ToolTip="Save the list and each file's result to pick up later">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="SaveSessionItem" Text="Save session..." Click="SaveSession_Click" IsEnabled="False">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="LoadSessionItem" Text="Load session..." Click="LoadSession_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="AutosaveItem" Text="Autosave" Click="Autosave_Click"
                                                  ToolTipService.ToolTip="Keep the saved session file up to date as files are added and converted, and reopen it when the app starts" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="HistoryButton" Content="History"
                                ToolTipService.ToolTip="Every file converted, discarded or skipped, kept across sessions so they are not queued again until they change">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Import history..." Click="ImportHistory_Click"
                                            ToolTipService.ToolTip="Add the files and folders from a history file to this one">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export history..." Click="ExportHistory_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Clear history..." Click="ClearHistory_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="OptionsButton" Click="Options_Click" AutomationProperties.Name="Options"
                        ToolTipService.ToolTip="Skip HEVC files and delete options">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Options..." />
                    </StackPanel>
                </Button>
            </app:WrapPanel>
            <app:WrapPanel>
                <!-- Only one of these shows: Convert while idle, the run button while a queue runs. -->
                <Button x:Name="ConvertButton" Content="Convert" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="Convert_Click" IsEnabled="False" />
                <SplitButton x:Name="RunButton" Content="Pause" MinWidth="120" Click="Pause_Click" Visibility="Collapsed"
                             ToolTipService.ToolTip="Pause lets the current file finish, then holds the rest of the queue until you resume. Cancel is under the arrow.">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Cancel" Click="Cancel_Click"
                                            ToolTipService.ToolTip="Stop now. The file being converted is discarded and the original kept.">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" VerticalAlignment="Center"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTipService.ToolTip="Scroll the list to each file as it starts converting" />
                <CheckBox x:Name="ShutdownBox" Content="Shut down when finished" VerticalAlignment="Center"
                          ToolTipService.ToolTip="After the whole queue finishes, shut down Windows following a 60-second countdown you can cancel. Not remembered between sessions." />
            </app:WrapPanel>
        </app:WrapPanel>

        <StackPanel Grid.Row="5" Spacing="4">
            <InfoBar x:Name="Info" IsOpen="False" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="140" AutomationProperties.Name="Show files with status"
                          SelectionChanged="FilterBox_SelectionChanged"
                          ToolTipService.ToolTip="Show only files with this status. Convert still runs every unfinished file in the list." />
            </Grid>
            <ProgressBar x:Name="OverallProgress" Maximum="1" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Outside the ListView so it stays put while the list scrolls; padding matches the item container's margin + padding
                 plus the 24px each row's selection checkbox takes. -->
            <Grid ColumnSpacing="12" Padding="44,8,16,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="File" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="3" Text="Size change" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="4" Text="Result" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="5" Text="Decision" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
        <ListView x:Name="Queue" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="Queue_SelectionChanged" GotFocus="Queue_GotFocus" DoubleTapped="Queue_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConvertItem">
                    <Grid ColumnSpacing="12" Padding="0,6" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open original" Tag="{x:Bind Path}" IsEnabled="{x:Bind HasOriginal, Mode=OneWay}" Click="Open_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open output" Tag="{x:Bind OutputPath, Mode=OneWay}" IsEnabled="{x:Bind HasOutput, Mode=OneWay}" Click="Open_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Open original location" Tag="{x:Bind Path}" IsEnabled="{x:Bind HasOriginal, Mode=OneWay}" Click="ShowInFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open output location" Tag="{x:Bind OutputPath, Mode=OneWay}" IsEnabled="{x:Bind HasOutput, Mode=OneWay}" Click="ShowInFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Copy original path" Tag="{x:Bind Path}" Click="CopyPath_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy output path" Tag="{x:Bind OutputPath, Mode=OneWay}" IsEnabled="{x:Bind HasOutput, Mode=OneWay}" Click="CopyPath_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SizesText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="Original size, then output size" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeChangeText, Mode=OneWay}" Foreground="{x:Bind SizeChangeBrush, Mode=OneWay}"
                                   VerticalAlignment="Center" ToolTipService.ToolTip="Output size compared with the original" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Decision, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Decision, Mode=OneWay}" />
                        <Grid Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}" />
                            <Grid ColumnSpacing="8" Visibility="{x:Bind IsConverting, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>

        <TextBox x:Name="DetailsBox" Grid.Row="7" Header="ffmpeg command and log for selected file" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="140" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
