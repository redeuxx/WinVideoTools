<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinVideoTools.SimilarVideos.SimilarVideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinVideoTools.SimilarVideos"
    xmlns:app="using:WinVideoTools"
    NavigationCacheMode="Required">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Similar Videos" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="FolderList" SelectionMode="None" MaxHeight="160" MinHeight="40" AutomationProperties.Name="Folders to compare"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind}" />
                            <Button Grid.Column="1" Tag="{x:Bind}" Click="RemoveFolder_Click" Padding="6"
                                    ToolTipService.ToolTip="Remove folder" AutomationProperties.Name="Remove folder">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="NoFoldersText" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Text="Add one or more folders. Videos in all of them are compared with each other."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="AddFolderButton" Grid.Column="1" Content="Add folder..." Click="AddFolder_Click" VerticalAlignment="Top" />
        </Grid>

        <app:WrapPanel Grid.Row="2" HorizontalSpacing="16">
            <CheckBox x:Name="RecurseBox" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center" />
            <NumberBox x:Name="ParallelBox" Header="Files at once" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Width="160" />
            <NumberBox x:Name="DriftBox" Header="Max drift (seconds)" Minimum="1" SpinButtonPlacementMode="Inline" Width="160"
                       ToolTipService.ToolTip="How far apart in time the same moment may be in two copies, for example when one has a few seconds cut from the start. Higher values scan slower and may match more unrelated videos." />
            <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" VerticalAlignment="Bottom" />
            <Button x:Name="RefreshButton" Click="Refresh_Click" IsEnabled="False" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Re-list the folders and process only new or changed files (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
        </app:WrapPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar x:Name="Info" IsOpen="False" />
            <TextBlock x:Name="SummaryText" />
            <ProgressBar x:Name="OverallProgress" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <ListView x:Name="Results" SelectionMode="Single" DoubleTapped="Results_DoubleTapped" SelectionChanged="Results_SelectionChanged"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
            <ListView.Header>
                <Grid ColumnSpacing="12" Margin="16,8,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="File" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Dimensions" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Format" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Bit rate" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="Length and size" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </ListView.Header>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:DuplicateGroup">
                            <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DuplicateFile">
                    <Grid ColumnSpacing="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Tag="{x:Bind Path}" Click="Open_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open file location" Tag="{x:Bind Path}" Click="ShowInFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0"
                                  AutomationProperties.Name="{x:Bind Path}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Dimensions}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Format}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Format}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Bitrate}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Description}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="PreviewPane" Grid.Column="1" Width="400" Visibility="Collapsed" Padding="12" RowSpacing="8"
              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewTitle" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="ClosePreview_Click" Padding="6" VerticalAlignment="Top"
                    ToolTipService.ToolTip="Close preview" AutomationProperties.Name="Close preview">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" MinHeight="120">
                <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Screenshot from the middle of the video" />
                <ProgressRing x:Name="PreviewRing" IsActive="False" />
            </Grid>
            <TextBlock x:Name="PreviewError" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </Grid>
        </Grid>

        <!-- Groups wrap as units so selection and file actions stay together when the window is narrow.
             SelectionText has a MinWidth so a changing count does not move the file actions to another line. -->
        <app:WrapPanel Grid.Row="5" HorizontalSpacing="16">
            <app:WrapPanel>
                <Button x:Name="SelectBestButton" Content="Select all but best copy" Click="SelectBest_Click" IsEnabled="False"
                        ToolTipService.ToolTip="In each group, keeps the highest resolution (then smallest) file and selects the rest" />
                <Button x:Name="ClearButton" Content="Clear selection" Click="Clear_Click" IsEnabled="False" />
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="100" />
            </app:WrapPanel>
            <app:WrapPanel>
                <Button x:Name="RecycleButton" Content="Move to Recycle Bin" Click="Recycle_Click" IsEnabled="False" />
                <Button x:Name="MoveButton" Content="Move to folder..." Click="Move_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Content="Delete permanently" Click="Delete_Click" IsEnabled="False" />
            </app:WrapPanel>
        </app:WrapPanel>
    </Grid>
</Page>
