<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinVideoTools.VideoVerifier.VideoVerifierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinVideoTools.VideoVerifier"
    xmlns:app="using:WinVideoTools"
    NavigationCacheMode="Required">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Video Verifier" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" PlaceholderText="Folder to scan" AutomationProperties.Name="Folder to scan" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="Browse_Click" />
        </Grid>

        <!-- Takes no space until shown. The checkboxes keep their names, so code reads them as before. -->
        <ContentDialog x:Name="OptionsDialog" Title="Verify options" CloseButtonText="Close" DefaultButton="Close">
            <StackPanel Spacing="12">
                <CheckBox x:Name="RecurseBox" Content="Include subfolders" IsChecked="True" />
                <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                          ToolTipService.ToolTip="Scroll the list to each file as it starts being checked" />
                <NumberBox x:Name="DamageLimitBox" Header="Allowed damage (% of video frames)" Value="1" Minimum="0" Maximum="100"
                           SmallChange="0.5" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="260"
                           ToolTipService.ToolTip="A file that decodes to full length with at most this share of damaged packets is marked Valid, errors (yellow) instead of Invalid. 0 marks any damage invalid." />
            </StackPanel>
        </ContentDialog>

        <app:WrapPanel Grid.Row="2" HorizontalSpacing="16">
            <NumberBox x:Name="ParallelBox" Header="Files at once" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Width="160" />
            <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" VerticalAlignment="Bottom" />
            <Button x:Name="RefreshButton" Click="Refresh_Click" IsEnabled="False" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Re-list the folder and process only new or changed files (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="ExportButton" Content="Export CSV..." Click="Export_Click" IsEnabled="False" VerticalAlignment="Bottom" />
            <Button x:Name="ClearListButton" Content="Clear list" Click="ClearList_Click" IsEnabled="False" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Remove all results from the list (files are not touched)" />
            <Button Click="Options_Click" VerticalAlignment="Bottom" AutomationProperties.Name="Options"
                    ToolTipService.ToolTip="Include subfolders, auto-scroll and allowed damage">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Options..." />
                </StackPanel>
            </Button>
        </app:WrapPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar x:Name="Info" IsOpen="False" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="140" AutomationProperties.Name="Show files with status"
                          SelectionChanged="FilterBox_SelectionChanged"
                          ToolTipService.ToolTip="Show only files with this status. Processing includes files not checked yet." />
            </Grid>
            <ProgressBar x:Name="OverallProgress" Visibility="Collapsed" />
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="4" SelectionMode="Multiple" SelectionChanged="Results_SelectionChanged"
                  DoubleTapped="Results_DoubleTapped" GotFocus="Results_GotFocus"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4"
                  ItemContainerStyle="{StaticResource CheckOnlyListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:VideoItem">
                    <Grid ColumnSpacing="12" Padding="12,6" Background="Transparent" PointerPressed="Row_PointerPressed">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Tag="{x:Bind Path}" Click="Open_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open file location" Tag="{x:Bind Path}" Click="ShowInFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}" />
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" Visibility="{x:Bind IsChecking, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- SelectionText keeps its line when empty so the list above does not resize as the count comes and goes. -->
        <StackPanel Grid.Row="5" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DropDownButton x:Name="SelectButton" Content="Select" IsEnabled="False">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Select valid" Click="SelectValid_Click" />
                            <MenuFlyoutItem Text="Select invalid" Click="SelectInvalid_Click"
                                            ToolTipService.ToolTip="Selects files that failed verification or could not be checked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Clear selection" Click="Clear_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <SplitButton x:Name="FileActionButton" Content="Delete permanently" Click="Delete_Click" IsEnabled="False">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Move to Recycle Bin" Click="Recycle_Click" />
                            <MenuFlyoutItem Text="Move to folder..." Click="Move_Click" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>
            <TextBlock x:Name="SelectionText" MinHeight="20" />
        </StackPanel>

        <Grid Grid.Row="6" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Details for selected file" VerticalAlignment="Bottom" />
            <Button Grid.Column="1" Click="CopyDetails_Click" ToolTipService.ToolTip="Copy the details" AutomationProperties.Name="Copy details">
                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
            </Button>
            <TextBox x:Name="DetailsBox" Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Details for selected file" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="140" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Page>
