<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinVideoTools.VideoVerifier.VideoVerifierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinVideoTools.VideoVerifier"
    NavigationCacheMode="Required">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Video Verifier" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" PlaceholderText="Folder to scan" AutomationProperties.Name="Folder to scan" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="RecurseBox" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center" />
            <NumberBox x:Name="ParallelBox" Header="Files at once" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Width="160" />
            <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" VerticalAlignment="Bottom" />
            <Button x:Name="RefreshButton" Click="Refresh_Click" IsEnabled="False" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Re-list the folder and process only new or changed files (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="ExportButton" Content="Export CSV..." Click="Export_Click" IsEnabled="False" VerticalAlignment="Bottom" />
            <Button x:Name="ClearListButton" Content="Clear list" Click="ClearList_Click" IsEnabled="False" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Remove all results from the list (files are not touched)" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar x:Name="Info" IsOpen="False" />
            <TextBlock x:Name="SummaryText" />
            <ProgressBar x:Name="OverallProgress" Visibility="Collapsed" />
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="4" SelectionMode="Multiple" SelectionChanged="Results_SelectionChanged"
                  DoubleTapped="Results_DoubleTapped"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:VideoItem">
                    <Grid ColumnSpacing="12" Padding="0,6" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Tag="{x:Bind Path}" Click="Open_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}" />
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" Visibility="{x:Bind IsChecking, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectValidButton" Content="Select valid" Click="SelectValid_Click" IsEnabled="False" />
            <Button x:Name="SelectInvalidButton" Grid.Column="1" Content="Select invalid" Click="SelectInvalid_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Selects files that failed verification or could not be checked" />
            <Button x:Name="ClearButton" Grid.Column="2" Content="Clear selection" Click="Clear_Click" IsEnabled="False" />
            <TextBlock x:Name="SelectionText" Grid.Column="3" VerticalAlignment="Center" Margin="8,0" />
            <Button x:Name="RecycleButton" Grid.Column="4" Content="Move to Recycle Bin" Click="Recycle_Click" IsEnabled="False" />
            <Button x:Name="MoveButton" Grid.Column="5" Content="Move to folder..." Click="Move_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Grid.Column="6" Content="Delete permanently" Click="Delete_Click" IsEnabled="False" />
        </Grid>

        <TextBox x:Name="DetailsBox" Grid.Row="6" Header="Details for selected file" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="140" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
